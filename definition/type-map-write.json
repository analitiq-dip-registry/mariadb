{
  "$schema": "https://schemas.analitiq.ai/type-map-write/latest.json",
  "direction": "write",
  "rules": [
    {
      "match": "exact",
      "native_type": "TINYINT(1)",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "TINYINT",
      "arrow_type": "Int8"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT",
      "arrow_type": "Int16"
    },
    {
      "match": "exact",
      "native_type": "INT",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "BIGINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "TINYINT UNSIGNED",
      "arrow_type": "UInt8"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT UNSIGNED",
      "arrow_type": "UInt16"
    },
    {
      "match": "exact",
      "native_type": "INT UNSIGNED",
      "arrow_type": "UInt32"
    },
    {
      "match": "exact",
      "native_type": "BIGINT UNSIGNED",
      "arrow_type": "UInt64"
    },
    {
      "match": "exact",
      "native_type": "FLOAT",
      "arrow_type": "Float16"
    },
    {
      "match": "exact",
      "native_type": "FLOAT",
      "arrow_type": "Float32"
    },
    {
      "match": "exact",
      "native_type": "DOUBLE",
      "arrow_type": "Float64"
    },
    {
      "match": "regex",
      "native_type": "DECIMAL(${p}, ${s})",
      "arrow_type": "^Decimal(?:128|256)\\((?<p>[1-9]|[1-5]\\d|6[0-5]),\\s*(?<s>\\d|[12]\\d|30)\\)$"
    },
    {
      "match": "exact",
      "native_type": "VARCHAR(255)",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "LONGTEXT",
      "arrow_type": "LargeUtf8"
    },
    {
      "match": "exact",
      "native_type": "VARCHAR(255)",
      "arrow_type": "Null"
    },
    {
      "match": "exact",
      "native_type": "BLOB",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "LONGBLOB",
      "arrow_type": "LargeBinary"
    },
    {
      "match": "regex",
      "native_type": "BINARY(${width})",
      "arrow_type": "^FixedSizeBinary\\((?<width>[1-9]\\d?|1\\d\\d|2[0-4]\\d|25[0-5])\\)$"
    },
    {
      "match": "regex",
      "native_type": "LONGBLOB",
      "arrow_type": "^FixedSizeBinary\\(\\d+\\)$"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date32"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date64"
    },
    {
      "match": "regex",
      "native_type": "TIME(0)",
      "arrow_type": "^Time32\\(SECOND\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIME(3)",
      "arrow_type": "^Time32\\(MILLISECOND\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIME(6)",
      "arrow_type": "^Time64\\((?:MICROSECOND|NANOSECOND)\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIME(0)",
      "arrow_type": "^Duration\\(SECOND\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIME(3)",
      "arrow_type": "^Duration\\(MILLISECOND\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIME(6)",
      "arrow_type": "^Duration\\((?:MICROSECOND|NANOSECOND)\\)$"
    },
    {
      "match": "regex",
      "native_type": "DATETIME(0)",
      "arrow_type": "^Timestamp\\(SECOND(?:,\\s*[^)]+)?\\)$"
    },
    {
      "match": "regex",
      "native_type": "DATETIME(3)",
      "arrow_type": "^Timestamp\\(MILLISECOND(?:,\\s*[^)]+)?\\)$"
    },
    {
      "match": "regex",
      "native_type": "DATETIME(6)",
      "arrow_type": "^Timestamp\\((?:MICROSECOND|NANOSECOND)(?:,\\s*[^)]+)?\\)$"
    },
    {
      "match": "exact",
      "native_type": "JSON",
      "arrow_type": "Json"
    },
    {
      "match": "exact",
      "native_type": "JSON",
      "arrow_type": "Object"
    },
    {
      "match": "exact",
      "native_type": "JSON",
      "arrow_type": "List"
    }
  ]
}

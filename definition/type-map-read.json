{
  "$schema": "https://schemas.analitiq.ai/type-map-read/latest.json",
  "direction": "read",
  "rules": [
    {
      "match": "regex",
      "native_type": "^BIT\\(1\\)$",
      "arrow_type": "Boolean"
    },
    {
      "match": "regex",
      "native_type": "^BIT(?:\\(\\d+\\))?$",
      "arrow_type": "Binary"
    },
    {
      "match": "regex",
      "native_type": "^TINYINT\\(1\\)$",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "BOOL",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "BOOLEAN",
      "arrow_type": "Boolean"
    },
    {
      "match": "regex",
      "native_type": "^TINYINT(?:\\(\\d+\\))? UNSIGNED(?: ZEROFILL)?$",
      "arrow_type": "UInt8"
    },
    {
      "match": "regex",
      "native_type": "^TINYINT(?:\\(\\d+\\))?$",
      "arrow_type": "Int8"
    },
    {
      "match": "regex",
      "native_type": "^SMALLINT(?:\\(\\d+\\))? UNSIGNED(?: ZEROFILL)?$",
      "arrow_type": "UInt16"
    },
    {
      "match": "regex",
      "native_type": "^SMALLINT(?:\\(\\d+\\))?$",
      "arrow_type": "Int16"
    },
    {
      "match": "regex",
      "native_type": "^MEDIUMINT(?:\\(\\d+\\))? UNSIGNED(?: ZEROFILL)?$",
      "arrow_type": "UInt32"
    },
    {
      "match": "regex",
      "native_type": "^MEDIUMINT(?:\\(\\d+\\))?$",
      "arrow_type": "Int32"
    },
    {
      "match": "regex",
      "native_type": "^(?:INT|INTEGER)(?:\\(\\d+\\))? UNSIGNED(?: ZEROFILL)?$",
      "arrow_type": "UInt32"
    },
    {
      "match": "regex",
      "native_type": "^(?:INT|INTEGER)(?:\\(\\d+\\))?$",
      "arrow_type": "Int32"
    },
    {
      "match": "regex",
      "native_type": "^BIGINT(?:\\(\\d+\\))? UNSIGNED(?: ZEROFILL)?$",
      "arrow_type": "UInt64"
    },
    {
      "match": "regex",
      "native_type": "^BIGINT(?:\\(\\d+\\))?$",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "SERIAL",
      "arrow_type": "UInt64"
    },
    {
      "match": "regex",
      "native_type": "^(?:DECIMAL|DEC|NUMERIC|FIXED)\\((?<precision>[1-9]|[12]\\d|3[0-8]),\\s*(?<scale>\\d+)\\)(?: UNSIGNED)?(?: ZEROFILL)?$",
      "arrow_type": "Decimal128(${precision}, ${scale})"
    },
    {
      "match": "regex",
      "native_type": "^(?:DECIMAL|DEC|NUMERIC|FIXED)\\((?<precision>39|[45]\\d|6[0-5]),\\s*(?<scale>\\d+)\\)(?: UNSIGNED)?(?: ZEROFILL)?$",
      "arrow_type": "Decimal256(${precision}, ${scale})"
    },
    {
      "match": "regex",
      "native_type": "^(?:DECIMAL|DEC|NUMERIC|FIXED)\\((?<precision>[1-9]|[12]\\d|3[0-8])\\)(?: UNSIGNED)?(?: ZEROFILL)?$",
      "arrow_type": "Decimal128(${precision}, 0)"
    },
    {
      "match": "regex",
      "native_type": "^(?:DECIMAL|DEC|NUMERIC|FIXED)\\((?<precision>39|[45]\\d|6[0-5])\\)(?: UNSIGNED)?(?: ZEROFILL)?$",
      "arrow_type": "Decimal256(${precision}, 0)"
    },
    {
      "match": "regex",
      "native_type": "^(?:DECIMAL|DEC|NUMERIC|FIXED)(?: UNSIGNED)?(?: ZEROFILL)?$",
      "arrow_type": "Decimal128(10, 0)"
    },
    {
      "match": "regex",
      "native_type": "^FLOAT(?:\\(\\d+(?:,\\s*\\d+)?\\))?(?: UNSIGNED)?(?: ZEROFILL)?$",
      "arrow_type": "Float32"
    },
    {
      "match": "regex",
      "native_type": "^(?:DOUBLE(?: PRECISION)?|REAL)(?:\\(\\d+(?:,\\s*\\d+)?\\))?(?: UNSIGNED)?(?: ZEROFILL)?$",
      "arrow_type": "Float64"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date32"
    },
    {
      "match": "regex",
      "native_type": "^DATETIME\\(0\\)$",
      "arrow_type": "Timestamp(SECOND)"
    },
    {
      "match": "regex",
      "native_type": "^DATETIME\\([1-3]\\)$",
      "arrow_type": "Timestamp(MILLISECOND)"
    },
    {
      "match": "regex",
      "native_type": "^DATETIME\\([4-6]\\)$",
      "arrow_type": "Timestamp(MICROSECOND)"
    },
    {
      "match": "exact",
      "native_type": "DATETIME",
      "arrow_type": "Timestamp(SECOND)"
    },
    {
      "match": "regex",
      "native_type": "^TIMESTAMP\\(0\\)$",
      "arrow_type": "Timestamp(SECOND, UTC)"
    },
    {
      "match": "regex",
      "native_type": "^TIMESTAMP\\([1-3]\\)$",
      "arrow_type": "Timestamp(MILLISECOND, UTC)"
    },
    {
      "match": "regex",
      "native_type": "^TIMESTAMP\\([4-6]\\)$",
      "arrow_type": "Timestamp(MICROSECOND, UTC)"
    },
    {
      "match": "exact",
      "native_type": "TIMESTAMP",
      "arrow_type": "Timestamp(SECOND, UTC)"
    },
    {
      "match": "regex",
      "native_type": "^TIME\\(0\\)$",
      "arrow_type": "Duration(SECOND)"
    },
    {
      "match": "regex",
      "native_type": "^TIME\\([1-3]\\)$",
      "arrow_type": "Duration(MILLISECOND)"
    },
    {
      "match": "regex",
      "native_type": "^TIME\\([4-6]\\)$",
      "arrow_type": "Duration(MICROSECOND)"
    },
    {
      "match": "exact",
      "native_type": "TIME",
      "arrow_type": "Duration(SECOND)"
    },
    {
      "match": "regex",
      "native_type": "^YEAR(?:\\(\\d\\))?$",
      "arrow_type": "Int16"
    },
    {
      "match": "regex",
      "native_type": "^CHAR\\((?<width>\\d+)\\) BYTE$",
      "arrow_type": "FixedSizeBinary(${width})"
    },
    {
      "match": "exact",
      "native_type": "CHAR BYTE",
      "arrow_type": "FixedSizeBinary(1)"
    },
    {
      "match": "regex",
      "native_type": "^(?:(?:N|NATIONAL )?VARCHAR|(?:NATIONAL )?CHARACTER VARYING)(?:\\(\\d+\\))?$",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^(?:N|NATIONAL )?CHAR(?:ACTER)?(?:\\(\\d+\\))?$",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "TINYTEXT",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^TEXT(?:\\(\\d+\\))?$",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "MEDIUMTEXT",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "LONGTEXT",
      "arrow_type": "LargeUtf8"
    },
    {
      "match": "regex",
      "native_type": "^BINARY\\((?<width>\\d+)\\)$",
      "arrow_type": "FixedSizeBinary(${width})"
    },
    {
      "match": "exact",
      "native_type": "BINARY",
      "arrow_type": "Binary"
    },
    {
      "match": "regex",
      "native_type": "^VARBINARY(?:\\(\\d+\\))?$",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "TINYBLOB",
      "arrow_type": "Binary"
    },
    {
      "match": "regex",
      "native_type": "^BLOB(?:\\(\\d+\\))?$",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "MEDIUMBLOB",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "LONGBLOB",
      "arrow_type": "LargeBinary"
    },
    {
      "match": "regex",
      "native_type": "^ENUM\\(.*\\)$",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "ENUM",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^SET\\(.*\\)$",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "SET",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "JSON",
      "arrow_type": "Json"
    },
    {
      "match": "exact",
      "native_type": "UUID",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "INET4",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "INET6",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^(?:GEOMETRY|POINT|LINESTRING|POLYGON|MULTIPOINT|MULTILINESTRING|MULTIPOLYGON|GEOMETRYCOLLECTION)$",
      "arrow_type": "Binary"
    }
  ]
}
